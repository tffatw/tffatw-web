# 會員帳號設定
# 格式：JSON 陣列，每個物件包含 account（帳號）、password（密碼）、name（顯示名稱）
# 範例：[{"account":"member01","password":"pass123","name":"台北連鎖"},{"account":"member02","password":"pass456","name":"台中連鎖"}]
VITE_MEMBER_ACCOUNTS=[{"account":"demo","password":"demo1234","name":"示範會員"}]

# Cloudflare Web Analytics
# 從 Cloudflare Dashboard → Web Analytics 取得 token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
